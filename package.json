{
  "name": "website-aquarela",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "APP_BUILD_MODE=public astro build",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "build:preview": "APP_BUILD_MODE=editorial-preview astro build",
    "build:release": "APP_BUILD_MODE=release pnpm check-release && APP_BUILD_MODE=release astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check-content": "tsx scripts/check-content.ts",
    "check-release": "tsx scripts/check-release.ts",
    "media:generate": "node scripts/generate-responsive-media.mjs",
    "test": "vitest run tests/unit",
    "test:e2e": "pnpm qa:build:e2e && playwright test",
    "test:e2e:public": "pnpm qa:build:e2e && playwright test --project=public",
    "test:e2e:preview": "pnpm qa:build:e2e && playwright test --project=preview",
    "qa:build:e2e": "node scripts/qa/build-e2e.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/svelte": "^7.1.0",
    "astro": "^5.14.1",
    "js-yaml": "^4.1.0",
    "sharp": "^0.34.3",
    "svelte": "^5.38.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.35.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-svelte": "^3.11.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
