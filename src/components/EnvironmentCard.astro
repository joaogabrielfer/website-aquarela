---
import { focalPointStyle, responsiveSrcset } from '../lib/responsive-media';

interface Props {
  name: string;
  purpose: string;
  index?: number;
  imageUrl?: string | null;
  imageAlt?: string | undefined;
  caption?: string | null | undefined;
  imageWidth?: number | undefined;
  imageHeight?: number | undefined;
  imageFocalPoint?: { x: number; y: number } | undefined;
  feature?: boolean;
  photos?: { src: string; alt: string; caption?: string | null }[];
  class?: string;
}

const {
  name,
  purpose,
  index,
  imageUrl,
  imageAlt,
  caption,
  imageWidth,
  imageHeight,
  imageFocalPoint,
  feature = false,
  photos = [],
  class: className,
} = Astro.props;

const photosForLightbox =
  photos.length > 0
    ? photos
    : imageUrl
      ? [{ src: imageUrl, alt: imageAlt || name, caption }]
      : [];
const lightboxPhotos = photosForLightbox.map((photo) => ({
  ...photo,
  caption: [name, purpose, photo.caption].filter(Boolean).join(' — '),
}));
const photoCount = lightboxPhotos.length;
const displayNumber =
  index !== undefined ? String(index + 1).padStart(2, '0') : null;
---

<article
  class:list={[
    'environment-card',
    'editorial-surface',
    { 'environment-card--feature': feature },
    className,
  ]}
  data-reveal
>
  {
    imageUrl && (
      <div class="card-media media-frame">
        <img
          src={imageUrl}
          srcset={responsiveSrcset(imageUrl, imageWidth)}
          sizes={
            feature
              ? '(min-width: 1024px) 58vw, 100vw'
              : '(min-width: 768px) 50vw, 100vw'
          }
          alt={imageAlt || name}
          width={imageWidth ?? (feature ? 1200 : 800)}
          height={imageHeight ?? (feature ? 800 : 600)}
          style={focalPointStyle(imageFocalPoint)}
          loading="lazy"
          decoding="async"
        />
        {displayNumber && (
          <span class="editorial-number env-badge" aria-hidden="true">
            {displayNumber}
          </span>
        )}
        <button
          class="lightbox-trigger"
          type="button"
          aria-label={`Ampliar foto: ${name}`}
          data-photos={JSON.stringify(lightboxPhotos)}
          onclick={`window.dispatchEvent(new CustomEvent('aquarela:lightbox', { detail: { photos: ${JSON.stringify(lightboxPhotos)}, index: 0 } }))`}
        >
          {photoCount > 1 && (
            <span class="photo-count-badge" aria-hidden="true">
              {photoCount} fotos
            </span>
          )}
          <span class="lightbox-trigger-icon" aria-hidden="true">
            ↗
          </span>
        </button>
        {caption && <p class="card-caption">{caption}</p>}
      </div>
    )
  }
  <div class="card-body">
    <h3 class="card-title">{name}</h3>
    <p class="card-purpose">{purpose}</p>
  </div>
</article>

<style>
  .environment-card {
    display: flex;
    flex-direction: column;
    background: var(--surface-soft);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  @media (hover: hover) {
    .environment-card:hover {
      background: #ffffff;
      border-color: rgba(0, 76, 115, 0.25);
      box-shadow: var(--shadow-elevated);
    }
  }

  .card-media {
    position: relative;
    border-radius: 0;
    aspect-ratio: 4 / 3;
  }

  .env-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    pointer-events: none;
  }

  .lightbox-trigger {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    gap: 8px;
    padding: 14px;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: #ffffff;
  }

  .lightbox-trigger-icon {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(12, 27, 38, 0.8);
    backdrop-filter: blur(8px);
    color: #ffffff;
    border-radius: 50%;
    font-size: 1.05rem;
    font-weight: 700;
    transition:
      background-color 240ms var(--ease),
      transform 240ms var(--ease);
  }

  .photo-count-badge {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    background: rgba(12, 27, 38, 0.82);
    backdrop-filter: blur(8px);
    color: #ffffff;
    border-radius: var(--radius-pill);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1;
  }

  .lightbox-trigger:focus-visible {
    outline: none;
  }

  .lightbox-trigger:focus-visible .lightbox-trigger-icon {
    outline: 3px solid var(--brand-navy);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px #ffffff;
  }

  @media (hover: hover) {
    .lightbox-trigger:hover .lightbox-trigger-icon {
      background: var(--action-primary);
      transform: scale(1.06);
    }
  }

  .card-caption {
    margin: 0;
    padding: 8px 14px;
    background: rgba(12, 27, 38, 0.76);
    color: #ffffff;
    font-size: 0.8125rem;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    pointer-events: none;
  }

  .card-body {
    padding: 22px 24px 26px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .card-title {
    margin: 0;
    font-size: calc(clamp(1.2rem, 1.8vw, 1.5rem) * var(--display-scale));
    line-height: 1.18;
    color: var(--text-ink);
  }

  .card-purpose {
    margin: 0;
    font-size: 0.96875rem;
    line-height: 1.55;
    color: var(--text-body);
  }

  @media (min-width: 960px) {
    .environment-card--feature {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr);
      align-items: stretch;
    }
    .environment-card--feature .card-media {
      aspect-ratio: 16 / 10;
      height: 100%;
    }
    .environment-card--feature .card-body {
      padding: 36px;
      justify-content: center;
      gap: 14px;
    }
    .environment-card--feature .card-title {
      font-size: calc(clamp(1.6rem, 2.5vw, 2.25rem) * var(--display-scale));
    }
    .environment-card--feature .card-purpose {
      font-size: 1.0625rem;
    }
  }
</style>
