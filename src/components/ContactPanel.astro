---
import Button from './Button.astro';
import TextLink from './TextLink.astro';
import { getPublicSchool } from '../lib/content/school';
import { whatsappUrl, telUrl } from '../lib/urls';
import type { InterestOption } from '../lib/interest';
import { BUILD_MODE } from '../lib/env';

interface Props {
  segments?: InterestOption[];
  activities?: InterestOption[];
}

const { segments = [], activities = [] } = Astro.props;
// Serialização explícita: somente slugs/nomes já projetados, nunca registros editoriais.
const interestOptions = JSON.stringify({
  segments: segments.map(({ slug, name }) => ({ slug, name })),
  activities: activities.map(({ slug, name }) => ({ slug, name })),
});

const school = getPublicSchool();
const isPreview = BUILD_MODE === 'editorial-preview';

const hasPhone = school.phoneE164 !== null;
const hasWhatsapp = school.whatsappE164 !== null;
const hasMap = school.mapUrl !== null;
const hasHours = school.officeHours !== null && school.officeHours !== '';
const hasAddress = school.address !== null;
const hasActions = hasPhone || hasWhatsapp;
const hasInfo = hasMap || hasHours || hasAddress;
const hasAnyContact = hasActions || hasInfo;
const hasBothGroups = hasActions && hasInfo;
---

<div class="contact-panel" data-visit-interest={interestOptions}>
  <div class="container contact-panel-inner">
    <p class="contact-panel-intro">
      Converse com a equipe para combinar sua visita.
    </p>

    <div class="contact-panel-interest" hidden>
      <p class="interest-label" aria-live="polite" aria-atomic="true"></p>
      <TextLink href="/ensino">Ver todas as etapas</TextLink>
    </div>

    {
      isPreview && !hasAnyContact ? (
        <div class="contact-panel-pending">
          <p>Contato aguardando confirmação</p>
        </div>
      ) : hasAnyContact ? (
        <div
          class:list={[
            'contact-panel-contacts',
            hasBothGroups && 'contact-panel-contacts--split',
          ]}
        >
          {hasActions && (
            <div class="contact-panel-group">
              {/* WhatsApp primary when confirmed, phone secondary */}
              {hasWhatsapp && school.whatsappE164 && (
                <Button
                  href={whatsappUrl(school.whatsappE164)}
                  data-visit-whatsapp={school.whatsappE164}
                  variant="primary"
                >
                  Conversar no WhatsApp
                </Button>
              )}

              {hasPhone && school.phoneE164 && (
                <Button
                  href={telUrl(school.phoneE164)}
                  variant={hasWhatsapp ? 'secondary' : 'primary'}
                >
                  Ligar para o colégio
                </Button>
              )}
            </div>
          )}

          {hasInfo && (
            <div class="contact-panel-group">
              {hasMap && school.mapUrl && (
                <TextLink href={school.mapUrl}>Como chegar</TextLink>
              )}

              {school.officeHours && (
                <div class="contact-panel-detail">
                  <strong>Horário:</strong> {school.officeHours}
                </div>
              )}

              {school.address && (
                <div class="contact-panel-detail">
                  <strong>Endereço:</strong> {school.address.street}
                  {school.address.number && `, ${school.address.number}`} —{' '}
                  {school.address.neighborhood}, {school.address.city}/
                  {school.address.state}
                  {school.address.postalCode &&
                    ` — ${school.address.postalCode}`}
                </div>
              )}
            </div>
          )}
        </div>
      ) : null
    }
  </div>
</div>

<script>
  import { resolveInterest, type InterestOption } from '../lib/interest';
  import { whatsappUrl } from '../lib/urls';

  // O HTML SSG mantém os contatos genéricos; só este contexto depende da URL runtime.
  const query = new URLSearchParams(window.location.search);
  document
    .querySelectorAll<HTMLElement>('[data-visit-interest]')
    .forEach((panel) => {
      const { segments, activities } = JSON.parse(
        panel.dataset.visitInterest!,
      ) as {
        segments: InterestOption[];
        activities: InterestOption[];
      };
      const interest = resolveInterest(query, segments, activities);
      if (!interest) return;

      const context = panel.querySelector<HTMLElement>(
        '.contact-panel-interest',
      );
      const label = panel.querySelector<HTMLElement>('.interest-label');
      if (context && label) {
        context.hidden = false;
        label.textContent = `Sobre: ${interest.humanName}`;
      }

      // Nunca criar canal nem usar o telefone como autorização para WhatsApp.
      const whatsapp = panel.querySelector<HTMLAnchorElement>(
        'a[data-visit-whatsapp]',
      );
      const phone = whatsapp?.dataset.visitWhatsapp;
      if (whatsapp && phone) {
        whatsapp.href = whatsappUrl(phone, interest.humanName);
      }
    });
</script>

<style>
  .contact-panel {
    background: var(--surface-paper);
    padding: var(--space-8) var(--space-5);
    border-radius: var(--radius-card);
  }
  .contact-panel-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    /* Pages provide the global container; avoid compounding its gutters when
       the panel is placed inside a section container. */
    width: 100%;
    max-width: none;
    margin-inline: 0;
  }
  .contact-panel-intro {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text-ink);
  }
  .contact-panel-interest[hidden] {
    display: none;
  }
  .contact-panel-interest {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .interest-label {
    margin: 0;
    font-weight: 500;
    color: var(--text-ink);
  }
  .contact-panel-contacts {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .contact-panel-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
    min-width: 0;
  }
  .contact-panel-pending {
    color: var(--text-muted);
    font-style: italic;
  }
  .contact-panel-detail {
    color: var(--text-ink);
    font-size: 1rem;
    line-height: 1.6;
  }
  .contact-panel-detail strong {
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .contact-panel {
      padding: var(--space-10);
    }
    .contact-panel-detail {
      font-size: 1.125rem;
    }
  }

  @media (min-width: 1100px) {
    .contact-panel-contacts--split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
      align-items: start;
      width: 100%;
    }
  }
</style>
