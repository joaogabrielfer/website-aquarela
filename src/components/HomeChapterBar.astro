---
interface ChapterItem {
  id: string;
  label: string;
}

interface Props {
  chapters: ChapterItem[];
}

const { chapters } = Astro.props;
---

<nav class="home-chapters" aria-label="Capítulos da página inicial">
  <div class="container home-chapters-inner">
    <span class="home-chapters-counter" aria-hidden="true">
      <strong data-chapter-counter>01</strong>
      <span>/</span>
      <small>{String(chapters.length).padStart(2, '0')}</small>
    </span>

    <div class="home-chapter-links">
      {
        chapters.map((chapter, idx) => (
          <a
            href={`#${chapter.id}`}
            aria-current={idx === 0 ? 'location' : undefined}
          >
            {chapter.label}
          </a>
        ))
      }
    </div>

    <button
      type="button"
      class="motion-toggle"
      data-motion-toggle
      aria-pressed="false"
    >
      <span data-motion-label>Reduzir movimento</span>
    </button>
  </div>
  <div class="home-progress" aria-hidden="true"></div>
</nav>

<style>
  .home-chapters {
    position: sticky;
    top: var(--site-header-height);
    z-index: var(--z-sticky);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .home-chapters-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
  }

  .home-chapters-counter {
    display: none;
    align-items: baseline;
    gap: 4px;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 800;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .home-chapters-counter strong {
    color: var(--action-primary);
  }

  .home-chapter-links {
    display: flex;
    align-items: center;
    gap: 20px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    min-width: 0;
  }

  .home-chapter-links::-webkit-scrollbar {
    display: none;
  }

  .home-chapter-links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 2px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.84375rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .home-chapter-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2.5px;
    background: var(--action-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 320ms var(--ease-expo);
  }

  .home-chapter-links a[aria-current],
  .home-chapter-links a:hover {
    color: var(--text-ink);
  }

  .home-chapter-links a[aria-current]::after {
    transform: scaleX(1);
  }

  .motion-toggle {
    display: none;
    flex-shrink: 0;
    align-items: center;
    min-height: 44px;
    padding: 8px 14px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--surface-soft);
    color: var(--text-ink);
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
  }

  .motion-toggle[aria-pressed='true'] {
    background: var(--surface-dark);
    color: #ffffff;
  }

  .home-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--action-primary);
    transform: scaleX(var(--reading-progress, 0));
    transform-origin: left;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .home-chapters-counter {
      display: inline-flex;
    }
    .home-chapter-links {
      gap: 28px;
    }
    .motion-toggle {
      display: inline-flex;
    }
  }
</style>
