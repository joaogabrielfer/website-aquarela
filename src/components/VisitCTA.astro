---
import Button from './Button.astro';

interface Props {
  title?: string;
  support?: string;
}

const { title = 'Venha conhecer o Aquarela', support } = Astro.props;
---

<section class="visit-cta">
  <div class="container visit-cta-inner">
    <div class="visit-cta-text">
      <h2 class="visit-cta-title">{title}</h2>
      {support && <p class="visit-cta-support">{support}</p>}
    </div>
    <Button href="/visite" variant="inverse">Quero conhecer</Button>
  </div>
</section>

<style>
  .visit-cta {
    background: var(--brand-navy);
    padding: var(--space-12) 0;
  }
  .visit-cta-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    align-items: flex-start;
  }
  .visit-cta-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .visit-cta-title {
    margin: 0;
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.15;
    color: white;
  }
  .visit-cta-support {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: white;
  }

  /* Tablet */
  @media (min-width: 768px) {
    .visit-cta {
      padding: var(--space-16) 0;
    }
    .visit-cta-title {
      font-size: 2.25rem;
    }
  }

  /* Desktop */
  @media (min-width: 1100px) {
    .visit-cta {
      padding: var(--space-20) 0;
    }
    .visit-cta-title {
      font-size: 2.5rem;
    }
  }
</style>
