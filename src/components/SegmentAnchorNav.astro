---
const anchors = [
  { slug: 'educacao-infantil', num: '01', label: 'Educação Infantil' },
  {
    slug: 'fundamental-anos-iniciais',
    num: '02',
    label: 'Fundamental · Anos Iniciais',
  },
  {
    slug: 'fundamental-anos-finais',
    num: '03',
    label: 'Fundamental · Anos Finais',
  },
  { slug: 'ensino-medio', num: '04', label: 'Ensino Médio' },
];
---

<nav class="segment-anchor-nav" aria-label="Etapas de ensino">
  <div class="container segment-anchor-nav__inner">
    {
      anchors.map((a) => (
        <a href={`/ensino#${a.slug}`} class="anchor-link">
          <span class="anchor-num" aria-hidden="true">
            {a.num}
          </span>
          <span>{a.label}</span>
        </a>
      ))
    }
  </div>
</nav>

<style>
  .segment-anchor-nav {
    position: sticky;
    top: var(--site-header-height);
    z-index: var(--z-sticky);
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    padding: 12px 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .segment-anchor-nav__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .anchor-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 16px;
    color: var(--text-ink);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    background: var(--surface-soft);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
  }

  .anchor-num {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--action-primary);
  }

  @media (hover: hover) {
    .anchor-link:hover {
      background: var(--brand-navy);
      border-color: var(--brand-navy);
      color: #ffffff;
    }
    .anchor-link:hover .anchor-num {
      color: var(--brand-yellow);
    }
  }

  .anchor-link:focus-visible {
    outline: 3px solid var(--brand-navy);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px #ffffff;
  }
</style>
