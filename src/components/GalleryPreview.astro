---
import { focalPointStyle, responsiveSrcset } from '../lib/responsive-media';

interface Photo {
  src: string;
  alt: string;
  title?: string;
  caption?: string | null;
  width?: number;
  height?: number;
  focalPoint?: { x: number; y: number };
}

interface Props {
  photos: Photo[];
  class?: string;
}

const { photos, class: className } = Astro.props;
const lightboxPhotos = photos.map((photo) => ({
  src: photo.src,
  alt: photo.alt,
  caption: photo.title || photo.caption || photo.alt,
  width: photo.width,
  height: photo.height,
}));
---

{
  photos.length > 0 && (
    <div class:list={['editorial-rail-wrap', className]}>
      <div
        class="editorial-rail"
        role="region"
        aria-label="Galeria horizontal de espaços do Aquarela"
      >
        {photos.map((photo, index) => (
          <figure
            class="rail-card"
            data-reveal
            style={`--reveal-delay: ${Math.min(index * 60, 240)}ms`}
          >
            <button
              type="button"
              class="rail-open media-frame"
              aria-label={`Ampliar foto: ${photo.title || photo.alt}`}
              onclick={`window.dispatchEvent(new CustomEvent('aquarela:lightbox', { detail: { photos: ${JSON.stringify(lightboxPhotos)}, index: ${index} } }))`}
            >
              <img
                src={photo.src}
                srcset={responsiveSrcset(photo.src, photo.width)}
                sizes="(min-width: 1100px) 38vw, (min-width: 768px) 58vw, 84vw"
                style={focalPointStyle(photo.focalPoint)}
                alt={photo.alt}
                width={photo.width ?? 1200}
                height={photo.height ?? 900}
                loading="eager"
                decoding="async"
              />
              <span class="rail-expand" aria-hidden="true">
                ↗
              </span>
            </button>
            <figcaption class="rail-caption">
              <span class="rail-index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="rail-label">
                {photo.title || photo.caption || photo.alt}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="rail-hint" aria-hidden="true">
        Deslize para explorar os espaços →
      </p>
    </div>
  )
}

<style>
  .editorial-rail-wrap {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .editorial-rail {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 12px;
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 76, 115, 0.35) transparent;
  }

  .rail-card {
    flex: 0 0 82%;
    max-width: 480px;
    margin: 0;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .rail-open {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--surface-elevated);
    cursor: pointer;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-media);
    overflow: hidden;
  }

  .rail-open:focus-visible {
    outline: 3px solid var(--brand-navy);
    outline-offset: 3px;
  }

  .rail-expand {
    position: absolute;
    right: 14px;
    bottom: 14px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(12, 27, 38, 0.78);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 700;
    transition:
      transform 260ms var(--ease),
      background-color 260ms var(--ease);
  }

  @media (hover: hover) {
    .rail-open:hover .rail-expand {
      background: var(--action-primary);
      transform: scale(1.06);
    }
  }

  .rail-caption {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding-inline: 2px;
  }

  .rail-index {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--action-primary);
    flex-shrink: 0;
  }

  .rail-label {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-ink);
    line-height: 1.3;
  }

  .rail-hint {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  @media (min-width: 768px) {
    .editorial-rail {
      gap: 22px;
    }
    .rail-card {
      flex: 0 0 46%;
    }
  }

  @media (min-width: 1100px) {
    .rail-card {
      flex: 0 0 36%;
      max-width: 520px;
    }
  }
</style>
