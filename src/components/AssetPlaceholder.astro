---
interface Props {
  aspectRatio?: string;
  class?: string;
}

const { aspectRatio = '4/3', class: className } = Astro.props;
---

<div
  class:list={['asset-placeholder', className]}
  style={`aspect-ratio: ${aspectRatio}`}
  role="img"
  aria-label="Foto oficial pendente"
>
  <span class="asset-placeholder-label">Foto oficial pendente</span>
</div>

<style>
  .asset-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-paper);
    border: 2px dashed var(--text-muted);
    border-radius: var(--radius-media);
    width: 100%;
  }
  .asset-placeholder-label {
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 500;
  }
</style>
