---
import type { PublicMedia } from '../lib/content';
import { responsiveSrcset } from '../lib/responsive-media';

interface Props {
  id?: string;
  media: PublicMedia;
  phrase: string;
  eyebrow?: string;
  desktopFocus?: string;
  mobileFocus?: string;
}

const { id, media, phrase, eyebrow, desktopFocus, mobileFocus } = Astro.props;

const defaultFocus = media.focalPoint
  ? `${Number((media.focalPoint.x * 100).toFixed(1))}% ${Number((media.focalPoint.y * 100).toFixed(1))}%`
  : '50% 42%';
const styleVars = `--focus-desktop: ${desktopFocus ?? defaultFocus}; --focus-mobile: ${mobileFocus ?? defaultFocus};`;
---

<section class="editorial-interlude" {id} aria-label={phrase} style={styleVars}>
  <div class="interlude-media" aria-hidden="true">
    <img
      src={media.src}
      srcset={responsiveSrcset(media.src, media.width)}
      sizes="100vw"
      alt={media.alt}
      width={media.width}
      height={media.height}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="interlude-veil" aria-hidden="true"></div>
  <div class="container interlude-copy" data-reveal>
    {eyebrow && <span class="interlude-eyebrow">{eyebrow}</span>}
    <p class="interlude-phrase">{phrase}</p>
  </div>
</section>

<style>
  .editorial-interlude {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: clamp(320px, 56svh, 680px);
    background: var(--surface-dark);
    overflow: hidden;
  }

  .interlude-media {
    position: absolute;
    inset: -32px 0;
    z-index: 0;
    transform: translate3d(0, var(--parallax-y, 0px), 0);
    will-change: transform;
  }

  .interlude-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus-mobile, 50% 42%);
  }

  .interlude-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(8, 20, 30, 0.14) 0%,
      rgba(8, 20, 30, 0.24) 48%,
      rgba(8, 20, 30, 0.84) 100%
    );
  }

  .interlude-copy {
    position: relative;
    z-index: 2;
    padding-block: clamp(2rem, 5vh, 4rem);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .interlude-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82);
  }

  .interlude-phrase {
    margin: 0;
    font-family: var(--font-display);
    font-size: calc(clamp(1.75rem, 5vw, 3.75rem) * var(--display-scale));
    font-weight: var(--display-weight);
    line-height: var(--display-lh);
    letter-spacing: var(--display-tracking);
    color: #ffffff;
    max-width: 18ch;
    text-wrap: balance;
    text-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
  }

  @media (min-width: 768px) {
    .editorial-interlude {
      min-height: clamp(440px, 74svh, 760px);
    }
    .interlude-media img {
      object-position: var(--focus-desktop, 50% 42%);
    }
  }
</style>
