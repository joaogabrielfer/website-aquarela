---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  tone?: 'light' | 'dark' | 'inverse';
}

const { items, tone = 'light' } = Astro.props;
---

<nav
  aria-label="Você está aqui"
  class:list={['breadcrumb', `breadcrumb--${tone}`]}
>
  <ol>
    {
      items.map((item, i) => {
        const isLast = i === items.length - 1;
        return (
          <li>
            {isLast ? (
              <span aria-current="page">{item.label}</span>
            ) : (
              <a href={item.href}>{item.label}</a>
            )}
            {!isLast && (
              <span class="separator" aria-hidden="true">
                ›
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-1);
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .breadcrumb li {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  @media (hover: hover) {
    .breadcrumb a:hover {
      text-decoration: underline;
    }
  }
  .breadcrumb span[aria-current='page'] {
    color: var(--text-ink);
  }
  .separator {
    color: var(--text-muted);
    margin: 0 var(--space-1);
  }
  .breadcrumb--dark a {
    color: var(--text-ink);
  }
  .breadcrumb--dark span[aria-current='page'] {
    color: var(--text-ink);
  }
  .breadcrumb--dark .separator {
    color: var(--text-ink);
  }
  .breadcrumb--inverse a {
    color: var(--surface-base);
  }
  .breadcrumb--inverse span[aria-current='page'] {
    color: var(--surface-base);
  }
  .breadcrumb--inverse .separator {
    color: var(--surface-base);
  }
  :global(.focus-on-navy) .breadcrumb a:focus-visible,
  .breadcrumb a:focus-visible {
    outline: 3px solid var(--brand-navy);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px white;
  }
  .breadcrumb--inverse a:focus-visible {
    outline: 3px solid var(--surface-base);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px var(--text-ink);
  }
</style>
