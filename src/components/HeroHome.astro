---
import { eyebrow } from '../lib/copy';
import Button from './Button.astro';
import AssetPlaceholder from './AssetPlaceholder.astro';
import { BUILD_MODE } from '../lib/env';
import { focalPointStyle, responsiveSrcset } from '../lib/responsive-media';

interface Props {
  title: string;
  support: string;
  imageSrc?: string | null;
  imageAlt?: string | undefined;
  imageWidth?: number | undefined;
  imageHeight?: number | undefined;
  imageFocalPoint?: { x: number; y: number } | undefined;
}

const {
  title,
  support,
  imageSrc,
  imageAlt,
  imageWidth,
  imageHeight,
  imageFocalPoint,
} = Astro.props;
const showImage = imageSrc !== null && imageSrc !== undefined;
const showPlaceholder = BUILD_MODE === 'editorial-preview' && !showImage;
const showMedia = showImage || showPlaceholder;
---

<section class="hero-home">
  <div class="hero-inner">
    <div class="hero-fade" aria-hidden="true"></div>
    <div class="container hero-inner-content">
      <div class="hero-copy">
        <p class="hero-eyebrow">{eyebrow}</p>
        <h1 class="hero-title">{title}</h1>
        {support && <p class="hero-support">{support}</p>}
        <div class="hero-actions">
          <Button href="/visite" variant="primary">Quero conhecer</Button>
          <Button href="/ensino" variant="secondary"
            >Explore nosso ensino</Button
          >
        </div>
      </div>
    </div>
    {
      showMedia ? (
        <div class="hero-media">
          {showImage ? (
            <img
              class="hero-photo"
              src={imageSrc}
              srcset={responsiveSrcset(imageSrc, imageWidth)}
              sizes="100vw"
              alt={imageAlt || 'Aquarela Colégio e Curso'}
              width={imageWidth ?? 2400}
              height={imageHeight ?? 1350}
              style={focalPointStyle(imageFocalPoint)}
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <AssetPlaceholder aspectRatio="16/9" />
          )}
        </div>
      ) : null
    }
  </div>
</section>

<style>
  .hero-home {
    background: var(--surface-paper);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: var(--space-12) 0;
    border-bottom: var(--space-3) solid var(--brand-red);
  }
  .hero-inner {
    position: relative;
    min-height: 0;
  }
  .hero-inner-content {
    position: relative;
    z-index: 2;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 42rem;
  }
  .hero-eyebrow {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    line-height: 1.4;
  }
  .hero-title {
    margin: 0;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.08;
    color: var(--text-ink);
    max-width: 22ch;
  }
  .hero-support {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--text-ink);
  }
  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
  }
  .hero-media {
    position: relative;
    margin: var(--space-8) auto 0;
    width: calc(100% - 40px);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-media);
    z-index: 0;
  }
  .hero-fade {
    display: none;
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      var(--surface-paper) 0%,
      var(--surface-paper) 27%,
      rgb(255 249 239 / 0.92) 50%,
      rgb(255 249 239 / 0.18) 78%,
      transparent 100%
    );
  }
  .hero-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Tablet */
  @media (min-width: 768px) {
    .hero-home {
      padding: var(--space-16) 0;
    }
    .hero-media {
      width: calc(100% - 64px);
    }
    .hero-title {
      font-size: 3.5rem;
    }
    .hero-support {
      font-size: 1.25rem;
    }
    .hero-actions {
      flex-direction: row;
      flex-wrap: wrap;
      width: auto;
    }
  }

  /* Desktop */
  @media (min-width: 1100px) {
    .hero-home {
      padding: var(--space-20) 0;
    }
    .hero-inner {
      min-height: 32rem;
    }
    .hero-media {
      position: absolute;
      margin: 0;
      aspect-ratio: 16 / 9;
      border-radius: 0;
      inset: calc(-1 * var(--space-20)) calc(-1 * var(--space-20)) auto auto;
      height: calc(100% + 2 * var(--space-20));
      width: auto;
      mask-image: linear-gradient(90deg, transparent, black 20%);
      -webkit-mask-image: linear-gradient(90deg, transparent, black 20%);
    }
    .hero-photo {
      object-fit: contain;
      object-position: right center;
    }
    .hero-fade {
      display: block;
      inset-block: calc(-1 * var(--space-20));
    }
    .hero-copy {
      gap: var(--space-6);
    }
    .hero-title {
      font-size: 4rem;
    }
    .hero-actions {
      flex-direction: row;
      flex-wrap: wrap;
      width: auto;
    }
  }
</style>
