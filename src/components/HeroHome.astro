---
import { eyebrow } from '../lib/copy';
import Button from './Button.astro';
import AssetPlaceholder from './AssetPlaceholder.astro';
import { focalPointStyle, responsiveSrcset } from '../lib/responsive-media';

interface Props {
  title: string;
  support: string;
  imageSrc?: string | null;
  imageAlt?: string | undefined;
  imageWidth?: number | undefined;
  imageHeight?: number | undefined;
  imageFocalPoint?: { x: number; y: number } | undefined;
}

const {
  title,
  support,
  imageSrc,
  imageAlt,
  imageWidth,
  imageHeight,
  imageFocalPoint,
} = Astro.props;
const showImage = imageSrc !== null && imageSrc !== undefined;
---

<section class="hero-home">
  <div class="hero-media" aria-hidden={showImage ? undefined : 'true'}>
    {
      showImage ? (
        <img
          class="hero-photo"
          src={imageSrc}
          srcset={responsiveSrcset(imageSrc, imageWidth)}
          sizes="100vw"
          alt={imageAlt || 'Aquarela Colégio e Curso'}
          width={imageWidth ?? 2400}
          height={imageHeight ?? 1350}
          style={focalPointStyle(imageFocalPoint)}
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <AssetPlaceholder aspectRatio="16/9" />
      )
    }
  </div>
  <div class="hero-veil" aria-hidden="true"></div>

  <div class="container hero-stage">
    <div class="hero-copy">
      <p class="hero-eyebrow">
        <span class="hero-dot" aria-hidden="true"></span>
        {eyebrow}
      </p>
      <h1 class="hero-title">{title}</h1>
      {support && <p class="hero-support">{support}</p>}
      <div class="hero-actions">
        <Button href="/visite" variant="primary" arrow>Quero conhecer</Button>
        <Button href="/ensino" variant="glass" arrow
          >Explore nosso ensino</Button
        >
      </div>
    </div>

    <a class="hero-explore focus-on-navy" href="#manifesto">
      <span class="hero-explore-text">Explorar</span>
      <span class="hero-explore-ring" aria-hidden="true">↓</span>
    </a>
  </div>
</section>

<style>
  .hero-home {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: calc(100svh - var(--site-header-height) - 72px);
    background: var(--surface-dark);
    color: #ffffff;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hero-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
    transform: scale(1.02);
  }

  @media (prefers-reduced-motion: no-preference) {
    html:not([data-motion='reduced']) .hero-photo {
      animation: hero-settle 16s var(--ease-expo) both;
    }
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1.01);
    }
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(8, 20, 30, 0.36) 0%,
      rgba(8, 20, 30, 0.34) 36%,
      rgba(8, 20, 30, 0.78) 72%,
      rgba(8, 20, 30, 0.92) 100%
    );
  }

  .hero-stage {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 24px;
    padding-block: clamp(2.5rem, 8vh, 4.5rem) clamp(2rem, 5vh, 3.75rem);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1rem, 2.2vh, 1.5rem);
    max-width: 56rem;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 6px 12px;
    width: fit-content;
    max-width: 100%;
    border-radius: var(--radius-pill);
    background: rgba(12, 27, 38, 0.58);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.22);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffffff;
    line-height: 1.3;
  }

  .hero-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand-yellow);
    box-shadow: 0 0 0 3px rgba(245, 184, 0, 0.28);
    flex-shrink: 0;
  }

  .hero-title {
    margin: 0;
    font-size: min(
      calc(clamp(2.15rem, 8.2vw, 5.25rem) * var(--display-scale)),
      12vw
    );
    font-weight: var(--display-weight);
    line-height: var(--display-lh);
    letter-spacing: var(--display-tracking);
    color: #ffffff;
    max-width: min(17ch, 100%);
    overflow-wrap: break-word;
    text-shadow: 0 10px 34px rgba(0, 0, 0, 0.34);
  }

  .hero-support {
    margin: 0;
    font-size: clamp(1rem, 1.7vw, 1.3125rem);
    font-weight: 500;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.92);
    max-width: 46ch;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    margin-top: 4px;
  }

  .hero-actions :global(.btn) {
    width: 100%;
  }

  .hero-explore {
    display: none;
    align-items: center;
    gap: 12px;
    align-self: flex-end;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero-explore-ring {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.52);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    font-size: 1rem;
    transition:
      background-color 260ms var(--ease),
      transform 260ms var(--ease);
  }

  @media (hover: hover) {
    .hero-explore:hover .hero-explore-ring {
      background: rgba(255, 255, 255, 0.2);
      transform: translateY(3px);
    }
  }

  @media (min-width: 560px) {
    .hero-actions {
      flex-direction: row;
      flex-wrap: wrap;
      width: auto;
    }
    .hero-actions :global(.btn) {
      width: auto;
    }
  }

  @media (min-width: 960px) {
    .hero-home {
      min-height: calc(100svh - var(--site-header-height) - 72px);
    }
    .hero-veil {
      background:
        linear-gradient(
          90deg,
          rgba(8, 20, 30, 0.86) 0%,
          rgba(8, 20, 30, 0.62) 48%,
          rgba(8, 20, 30, 0.28) 100%
        ),
        linear-gradient(
          180deg,
          rgba(8, 20, 30, 0.22) 0%,
          rgba(8, 20, 30, 0.16) 52%,
          rgba(8, 20, 30, 0.78) 100%
        );
    }
    .hero-stage {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      padding-block: clamp(4rem, 11vh, 7.5rem) clamp(3rem, 6vh, 4.75rem);
    }
    .hero-explore {
      display: inline-flex;
    }
  }
</style>
