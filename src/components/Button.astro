---
interface Props {
  variant?: 'primary' | 'secondary' | 'inverse' | 'glass' | 'text';
  size?: 'md' | 'sm';
  href?: string;
  target?: string;
  rel?: string;
  disabled?: boolean;
  icon?: string;
  arrow?: boolean;
  accessibleLabel?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
}

const {
  variant = 'primary',
  size = 'md',
  href,
  target,
  rel,
  disabled = false,
  icon,
  arrow = false,
  accessibleLabel,
  class: className,
  type = 'button',
  ...rest
} = Astro.props;

const isLink = href !== undefined && !disabled;
const Tag = isLink ? 'a' : 'button';
const tagProps = isLink
  ? {
      href,
      target,
      rel,
      'aria-disabled': disabled || undefined,
      tabindex: disabled ? -1 : undefined,
    }
  : { type, disabled };
---

<Tag
  class:list={[
    'btn',
    `btn--${variant}`,
    `btn--${size}`,
    'editorial-action',
    className,
  ]}
  {...tagProps}
  {...rest}
  aria-label={accessibleLabel}
>
  {
    icon && (
      <span class="btn-icon" aria-hidden="true">
        {icon}
      </span>
    )
  }
  <span class="btn-label"><slot /></span>
  {
    arrow && (
      <span class="btn-arrow" aria-hidden="true">
        ↗
      </span>
    )
  }
</Tag>

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: inherit;
    font-weight: 700;
    font-size: 0.96875rem;
    line-height: 1.3;
    text-decoration: none;
    border: 1px solid transparent;
    cursor: pointer;
    white-space: normal;
    text-align: center;
    transition:
      background-color 260ms var(--ease),
      color 260ms var(--ease),
      border-color 260ms var(--ease),
      box-shadow 320ms var(--ease),
      transform 260ms var(--ease);
  }

  .btn:focus-visible {
    outline: 3px solid var(--brand-navy);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px #ffffff;
  }

  .btn--md {
    min-height: 50px;
    padding: 13px 24px;
    border-radius: 16px;
  }

  .btn--sm {
    min-height: 44px;
    padding: 10px 18px;
    border-radius: 14px;
    font-size: 0.9375rem;
  }

  .btn--primary {
    background: var(--action-primary);
    color: #ffffff;
  }

  @media (hover: hover) {
    .btn--primary:hover {
      background: var(--action-hover);
      box-shadow: var(--shadow-action);
    }
  }

  .btn--primary:active {
    background: var(--action-pressed);
  }

  .btn--secondary {
    background: #ffffff;
    color: var(--brand-navy);
    border-color: rgba(0, 76, 115, 0.28);
  }

  @media (hover: hover) {
    .btn--secondary:hover {
      background: var(--brand-navy);
      color: #ffffff;
      border-color: var(--brand-navy);
    }
  }

  .btn--secondary:active {
    background: var(--brand-navy-deep);
    color: #ffffff;
  }

  .btn--glass {
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.44);
  }

  @media (hover: hover) {
    .btn--glass:hover {
      background: rgba(255, 255, 255, 0.24);
      border-color: rgba(255, 255, 255, 0.8);
    }
  }

  .btn--glass:focus-visible {
    outline-color: #ffffff;
    box-shadow: 0 0 0 2px var(--surface-dark);
  }

  .btn--inverse {
    background: #ffffff;
    color: var(--surface-dark);
    border-color: #ffffff;
  }

  @media (hover: hover) {
    .btn--inverse:hover {
      background: var(--surface-soft);
      box-shadow: 0 18px 34px -22px rgba(0, 0, 0, 0.45);
    }
  }

  .btn--inverse:active {
    background: var(--surface-elevated);
  }

  .btn--inverse:focus-visible {
    outline-color: #ffffff;
    box-shadow: 0 0 0 2px var(--surface-dark);
  }

  .btn--text {
    background: transparent;
    color: var(--brand-navy);
    border: none;
    text-decoration: underline;
    padding-left: 0;
    padding-right: 0;
  }

  @media (hover: hover) {
    .btn--text:hover {
      color: var(--action-primary);
    }
  }

  .btn:disabled,
  .btn[aria-disabled='true'] {
    background: var(--surface-disabled);
    color: var(--text-disabled);
    border-color: var(--surface-disabled);
    cursor: not-allowed;
    box-shadow: none;
    text-decoration: none;
  }

  .btn-icon {
    display: inline-flex;
    font-size: 1.15rem;
    line-height: 1;
  }

  .btn-label {
    line-height: inherit;
  }

  .btn-arrow {
    display: inline-block;
    font-size: 1rem;
    line-height: 1;
    transition: transform 300ms var(--ease);
    transform: translate(var(--magnet-x, 0px), var(--magnet-y, 0px));
  }

  @media (hover: hover) {
    .btn:hover .btn-arrow {
      transform: translate(
        calc(var(--magnet-x, 0px) + 2px),
        calc(var(--magnet-y, 0px) - 2px)
      );
    }
  }
</style>
