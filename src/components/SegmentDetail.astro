---
import type { PublicMedia } from '../lib/content';
import { empty } from '../lib/copy';
import { focalPointStyle, responsiveSrcset } from '../lib/responsive-media';
import AssetPlaceholder from './AssetPlaceholder.astro';
import Button from './Button.astro';

interface Props {
  slug: string;
  name: string;
  description?: string | null;
  experiences?: string[];
  grades?: string | null;
  ages?: string | null;
  shifts?: string[];
  image?: PublicMedia | null;
  tone?: 'white' | 'paper';
}

const {
  slug,
  name,
  description,
  experiences = [],
  grades,
  ages,
  shifts = [],
  image,
  tone = 'white',
} = Astro.props;

const hasMeta = grades || ages || shifts.length > 0;
const ctaHref = `/visite?interesse=${slug}`;
const displayDescription = description || empty.segment[0];
---

<section id={slug} class:list={['segment-detail', `segment-detail--${tone}`]}>
  <div class="container segment-detail-inner">
    <div class="segment-detail-layout">
      <h2 class="segment-detail-title">{name}</h2>
      <div class="segment-detail-content">
        {
          displayDescription && (
            <p class="segment-detail-desc">{displayDescription}</p>
          )
        }
        {
          experiences.length > 0 && (
            <ul class="segment-detail-experiences">
              {experiences.map((exp) => (
                <li>{exp}</li>
              ))}
            </ul>
          )
        }
        {
          hasMeta && (
            <div class="segment-detail-meta">
              {grades && (
                <p>
                  <strong>Séries:</strong> {grades}
                </p>
              )}
              {ages && (
                <p>
                  <strong>Idades:</strong> {ages}
                </p>
              )}
              {shifts.length > 0 && (
                <p>
                  <strong>Turnos:</strong> {shifts.join(', ')}
                </p>
              )}
            </div>
          )
        }
      </div>
      <div class="segment-detail-action">
        <Button href={ctaHref} variant="primary">
          Conversar sobre esta etapa
        </Button>
      </div>
      <div class="segment-detail-media">
        {
          image ? (
            <img
              class="segment-detail-photo"
              src={image.src}
              srcset={responsiveSrcset(image.src, image.width)}
              sizes="(min-width: 1100px) 420px, 100vw"
              alt={image.alt}
              width={image.width}
              height={image.height}
              style={focalPointStyle(image.focalPoint)}
              loading="lazy"
            />
          ) : (
            <AssetPlaceholder aspectRatio="4/3" />
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .segment-detail {
    padding: var(--space-12) 0;
    scroll-margin-top: 160px;
  }
  .segment-detail--white {
    background: var(--surface-base);
  }
  .segment-detail--paper {
    background: var(--surface-paper);
  }
  .segment-detail-inner {
    max-width: 1104px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .segment-detail-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'title'
      'content'
      'action'
      'media';
    gap: var(--space-6);
    align-items: start;
  }
  .segment-detail-title {
    grid-area: title;
    margin: 0;
    font-size: 1.875rem;
    line-height: 1.15;
  }
  .segment-detail-content {
    grid-area: content;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }
  .segment-detail-desc {
    margin: 0;
    max-width: 65ch;
    color: var(--text-ink);
  }
  .segment-detail-experiences {
    margin: 0;
    padding-left: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 65ch;
    color: var(--text-ink);
  }
  .segment-detail-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 65ch;
  }
  .segment-detail-meta p {
    margin: 0;
    color: var(--text-ink);
    font-size: 1rem;
    line-height: 1.6;
  }
  .segment-detail-action {
    grid-area: action;
    align-self: start;
    justify-self: start;
  }
  .segment-detail-media {
    grid-area: media;
    align-self: start;
    overflow: hidden;
  }
  .segment-detail-photo {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    aspect-ratio: 4/3;
    border-radius: var(--radius-media);
  }
  /* Tablet */
  @media (min-width: 768px) {
    .segment-detail {
      padding: var(--space-16) 0;
    }
    .segment-detail-title {
      font-size: 2.25rem;
    }
    .segment-detail-meta p {
      font-size: 1.125rem;
    }
  }

  /* Desktop */
  @media (min-width: 1100px) {
    .segment-detail-layout {
      grid-template-columns: 420px minmax(0, 1fr);
      grid-template-areas:
        'media title'
        'media content'
        'media action';
      column-gap: var(--space-10);
      row-gap: var(--space-5);
    }
    .segment-detail-title {
      font-size: 2.5rem;
    }
  }
</style>
