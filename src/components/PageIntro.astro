---
import Breadcrumb from './Breadcrumb.astro';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  breadcrumb?: BreadcrumbItem[];
  title: string;
  intro?: string | undefined;
  variant?: 'default' | 'paper' | 'space' | 'achievements' | 'activities';
}

const { breadcrumb, title, intro, variant = 'default' } = Astro.props;
---

<div class:list={['page-intro', `page-intro--${variant}`]}>
  <div class="container page-intro-inner">
    {
      breadcrumb && (
        <Breadcrumb
          items={breadcrumb}
          tone={
            variant === 'space' || variant === 'achievements' ? 'dark' : 'light'
          }
        />
      )
    }
    {variant === 'activities' && <div class="accent-line" aria-hidden="true" />}
    <h1>{title}</h1>
    {intro && <p class="reading">{intro}</p>}
  </div>
</div>

<style>
  .page-intro {
    padding: var(--space-10) 0;
  }
  .page-intro-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  h1 {
    margin: 0;
    font-size: 2.25rem;
    line-height: 1.1;
  }
  p {
    margin: 0;
    color: var(--text-ink);
  }
  .accent-line {
    width: 4px;
    height: 32px;
    background: var(--brand-purple);
    border-radius: 2px;
  }
  .page-intro--default {
    background: var(--surface-base);
  }
  .page-intro--paper {
    background: var(--surface-paper);
  }
  .page-intro--space {
    background: var(--brand-cyan);
    color: var(--text-ink);
  }
  .page-intro--achievements {
    background: var(--brand-yellow);
    color: var(--brand-navy);
  }
  .page-intro--activities {
    background: var(--surface-paper);
  }
  @media (min-width: 768px) {
    .page-intro {
      padding: var(--space-12) 0;
    }
    h1 {
      font-size: 2.75rem;
    }
  }
  @media (min-width: 1100px) {
    .page-intro {
      padding: var(--space-12) 0;
    }
    h1 {
      font-size: 3.25rem;
    }
  }
</style>
