---
import Breadcrumb from './Breadcrumb.astro';
import type { PublicMedia } from '../lib/content';
import { focalPointStyle, responsiveSrcset } from '../lib/responsive-media';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  breadcrumb?: BreadcrumbItem[];
  eyebrow?: string;
  title: string;
  intro?: string | undefined;
  media?: PublicMedia | null;
  variant?:
    | 'default'
    | 'paper'
    | 'space'
    | 'achievements'
    | 'activities'
    | 'teaching'
    | 'gallery';
}

const {
  breadcrumb,
  eyebrow,
  title,
  intro,
  media = null,
  variant = 'default',
} = Astro.props;

const isDark =
  Boolean(media) ||
  variant === 'teaching' ||
  variant === 'space' ||
  variant === 'achievements';
const tone = isDark ? 'inverse' : 'light';
---

<header
  class:list={[
    'page-intro',
    `page-intro--${variant}`,
    { 'page-intro--dark': isDark, 'page-intro--has-media': Boolean(media) },
  ]}
>
  {
    media && (
      <div class="page-intro-media" aria-hidden="true">
        <img
          src={media.src}
          srcset={responsiveSrcset(media.src, media.width)}
          sizes="100vw"
          alt=""
          width={media.width}
          height={media.height}
          style={focalPointStyle(media.focalPoint)}
          loading="eager"
          fetchpriority="high"
        />
        <div class="page-intro-veil" />
      </div>
    )
  }
  <div class="container page-intro-inner">
    {breadcrumb && <Breadcrumb items={breadcrumb} tone={tone} />}
    <div class="page-intro-copy">
      {
        eyebrow && (
          <p class:list={['eyebrow', { 'eyebrow--on-dark': isDark }]}>
            {eyebrow}
          </p>
        )
      }
      <h1>{title}</h1>
      {intro && <p class="page-intro-lead reading">{intro}</p>}
    </div>
  </div>
</header>

<style>
  .page-intro {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(2.5rem, 6vw, 5.25rem) clamp(2.5rem, 5.5vw, 4.75rem);
    background: var(--surface-soft);
    border-bottom: 1px solid var(--border-subtle);
  }

  .page-intro--dark {
    background: var(--surface-dark);
    color: #ffffff;
    border-bottom-color: rgba(255, 255, 255, 0.12);
  }

  .page-intro--has-media {
    min-height: clamp(290px, 44svh, 460px);
    display: flex;
    align-items: flex-end;
  }

  .page-intro-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-intro-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-intro-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(8, 20, 30, 0.56) 0%,
      rgba(8, 20, 30, 0.72) 55%,
      rgba(8, 20, 30, 0.92) 100%
    );
  }

  .page-intro-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .page-intro-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    max-width: 56rem;
  }

  h1 {
    margin: 0;
    max-width: 19ch;
  }

  .page-intro--dark h1 {
    color: #ffffff;
  }

  .page-intro-lead {
    margin: 0;
    font-size: clamp(1.03125rem, 1.7vw, 1.25rem);
    line-height: 1.55;
    color: var(--text-body);
  }

  .page-intro--dark .page-intro-lead {
    color: rgba(255, 255, 255, 0.88);
  }
</style>
