---
interface Props {
  icon: string;
  accessibleLabel: string;
  href?: string;
  disabled?: boolean;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
}

const {
  icon,
  accessibleLabel,
  href,
  disabled = false,
  class: className,
  type = 'button',
  ...rest
} = Astro.props;

const isLink = href !== undefined && !disabled;
const Tag = isLink ? 'a' : 'button';
const tagProps = isLink
  ? { href }
  : {
      type,
      disabled,
      'aria-disabled': disabled || undefined,
      tabindex: disabled ? -1 : undefined,
    };
---

<Tag
  class:list={['icon-btn', className]}
  {...tagProps}
  aria-label={accessibleLabel}
  {...rest}
>
  <span class="icon-btn-icon" aria-hidden="true">{icon}</span>
</Tag>

<style>
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-control);
    background: white;
    color: var(--text-ink);
    font-size: 1.25rem;
    text-decoration: none;
    cursor: pointer;
  }
  .icon-btn:disabled,
  .icon-btn[aria-disabled='true'] {
    background: var(--surface-disabled);
    color: var(--text-disabled);
    border-color: var(--surface-disabled);
    cursor: not-allowed;
  }
  @media (hover: hover) {
    .icon-btn:hover {
      background: var(--surface-paper);
    }
    .icon-btn:disabled:hover,
    .icon-btn[aria-disabled='true']:hover {
      background: var(--surface-disabled);
    }
  }
  .icon-btn:focus-visible {
    outline: 3px solid var(--brand-navy);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px white;
  }
  .icon-btn-icon {
    display: inline-flex;
    font-size: 1.25rem;
    line-height: 1;
  }
</style>
