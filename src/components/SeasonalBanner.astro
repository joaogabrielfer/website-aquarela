---
import type { PublicSeasonalBanner } from '../lib/content';

interface Props {
  banner: PublicSeasonalBanner;
}

const { banner } = Astro.props;
---

<aside
  class:list={['seasonal-banner', `seasonal-banner--${banner.tone}`]}
  aria-label="Aviso sazonal"
>
  <div class="container">
    <div class="seasonal-banner__card">
      <div class="seasonal-banner__copy">
        {
          banner.eyebrow && (
            <p class="seasonal-banner__eyebrow">{banner.eyebrow}</p>
          )
        }
        <h2>{banner.title}</h2>
        {banner.body && <p class="seasonal-banner__body">{banner.body}</p>}
      </div>
      {
        banner.ctaLabel && banner.href && (
          <a class="seasonal-banner__cta editorial-action" href={banner.href}>
            <span>{banner.ctaLabel}</span>
            <span aria-hidden="true">↗</span>
          </a>
        )
      }
    </div>
  </div>
</aside>

<style>
  .seasonal-banner {
    background: var(--surface-base);
    padding: clamp(1.25rem, 3vw, 2rem) 0;
  }

  .seasonal-banner__card {
    --banner-bg: var(--surface-soft);
    --banner-text: var(--text-ink);
    --banner-muted: var(--text-muted);
    --banner-cta-bg: var(--action-primary);
    --banner-cta-text: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    padding: clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 3.5vw, 2.5rem);
    border-radius: var(--radius-card);
    background: var(--banner-bg);
    color: var(--banner-text);
  }

  .seasonal-banner--navy .seasonal-banner__card {
    --banner-bg: var(--brand-navy);
    --banner-text: #ffffff;
    --banner-muted: rgba(255, 255, 255, 0.8);
    --banner-cta-bg: #ffffff;
    --banner-cta-text: var(--surface-dark);
  }

  .seasonal-banner--red .seasonal-banner__card {
    --banner-bg: var(--action-primary);
    --banner-text: #ffffff;
    --banner-muted: rgba(255, 255, 255, 0.86);
    --banner-cta-bg: #ffffff;
    --banner-cta-text: var(--action-primary);
  }

  .seasonal-banner--purple .seasonal-banner__card {
    --banner-bg: var(--brand-purple);
    --banner-text: #ffffff;
    --banner-muted: rgba(255, 255, 255, 0.86);
    --banner-cta-bg: #ffffff;
    --banner-cta-text: var(--brand-purple);
  }

  .seasonal-banner__copy {
    max-width: 64ch;
  }

  .seasonal-banner__eyebrow {
    margin: 0 0 8px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--banner-muted);
  }

  h2 {
    margin: 0;
    font-size: calc(clamp(1.25rem, 2.4vw, 1.85rem) * var(--display-scale));
    line-height: 1.15;
    color: var(--banner-text);
  }

  .seasonal-banner__body {
    margin: 8px 0 0;
    font-size: 0.96875rem;
    line-height: 1.55;
    color: var(--banner-muted);
  }

  .seasonal-banner__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 46px;
    padding: 10px 20px;
    border-radius: 14px;
    background: var(--banner-cta-bg);
    color: var(--banner-cta-text);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .seasonal-banner__card {
      flex-direction: row;
      align-items: center;
    }
  }
</style>
