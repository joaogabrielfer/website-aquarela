---
import { navigation } from '../lib/copy';
import { getPublicSchool } from '../lib/content/school';
import { formatPhone, whatsappUrl } from '../lib/urls';

const school = getPublicSchool();
const hasContact = Boolean(
  school.phoneE164 ||
  school.whatsappE164 ||
  school.mapUrl ||
  school.officeHours,
);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <div class="footer-brand">
        <img src="/favicon-192.png" alt="" width="56" height="56" />
        <span class="footer-brand-name"
          >Aquarela<span>Colégio e Curso</span></span
        >
      </div>
      {school.tagline && <p class="tagline">{school.tagline}</p>}
      <a class="footer-cta" href="/visite">Quero conhecer</a>
    </div>
    <nav aria-label="Navegação do rodapé">
      <strong>Navegação</strong>
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/visite">Visite</a>
      <a href="/privacidade">Privacidade</a>
    </nav>
    <div>
      <strong>Contato</strong>
      {
        !hasContact ? (
          <p class="pending">Contato aguardando confirmação</p>
        ) : (
          <>
            {school.address ? (
              <p class="footer-info">
                {school.address.street}
                {school.address.number && `, ${school.address.number}`} —{' '}
                {school.address.neighborhood},{' '}
                {`${school.address.city}/${school.address.state}`}
              </p>
            ) : (
              school.locality && <p class="footer-info">{school.locality}</p>
            )}
            {school.officeHours && (
              <p class="footer-info">Horário: {school.officeHours}</p>
            )}
            <div class="footer-links">
              {school.whatsappE164 && (
                <a href={whatsappUrl(school.whatsappE164)}>WhatsApp</a>
              )}
              {school.phoneE164 && (
                <a href={`tel:${school.phoneE164}`}>
                  {formatPhone(school.phoneE164)}
                </a>
              )}
              {school.instagramUrl && (
                <a href={school.instagramUrl} target="_blank" rel="noopener">
                  Instagram
                </a>
              )}
            </div>
          </>
        )
      }
    </div>
  </div>
  <p class="copyright">
    © {new Date().getFullYear()} Aquarela Colégio e Curso
  </p>
</footer>
<style>
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    padding: var(--space-8) 0
      calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
    background: var(--brand-navy);
    color: white;
  }
  .footer-grid {
    grid-template-columns: minmax(0, 1fr);
    display: grid;
    gap: var(--space-6);
  }
  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .footer-brand img {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    flex: none;
  }
  .footer-brand-name {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .footer-brand-name span {
    display: block;
    margin-top: var(--space-1);
    font-size: 0.875rem;
    font-weight: 400;
  }
  .tagline {
    color: white;
    font-size: 0.875rem;
    margin: var(--space-2) 0 0;
  }
  .footer-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin-top: var(--space-4);
    padding: 8px 20px;
    background: white;
    color: var(--brand-navy) !important;
    border-radius: var(--radius-pill);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
  }
  @media (hover: hover) {
    .footer-cta:hover {
      background: var(--surface-paper);
    }
  }
  .footer-grid > div:last-child {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }
  .footer-info {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-5);
    row-gap: var(--space-1);
  }
  .footer-grid nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-content: start;
    column-gap: var(--space-6);
    row-gap: var(--space-1);
  }
  .footer-grid nav strong {
    grid-column: 1 / -1;
    margin-bottom: var(--space-1);
  }
  .footer-grid a {
    display: inline-flex;
    align-items: center;
    color: white;
  }
  .pending {
    color: white;
    font-style: italic;
  }
  .copyright {
    max-width: 1296px;
    margin: var(--space-5) auto 0;
    padding: 0 max(20px, env(safe-area-inset-right, 0px)) 0
      max(20px, env(safe-area-inset-left, 0px));
    color: white;
    font-size: 0.875rem;
  }
  .site-footer a:focus-visible {
    outline-color: white;
    box-shadow: 0 0 0 2px var(--text-ink);
  }
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .copyright {
      padding-inline: max(32px, env(safe-area-inset-left, 0px))
        max(32px, env(safe-area-inset-right, 0px));
    }
  }
  @media (min-width: 1100px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .copyright {
      padding-inline: max(48px, env(safe-area-inset-left, 0px))
        max(48px, env(safe-area-inset-right, 0px));
    }
  }
</style>
