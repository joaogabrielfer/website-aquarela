---
import type { PublicMedia } from '../lib/content';
import { focalPointStyle, responsiveSrcset } from '../lib/responsive-media';
import AssetPlaceholder from './AssetPlaceholder.astro';

interface Props {
  slug: string;
  name: string;
  summary?: string | null;
  shifts?: string[];
  index?: number;
  image?: PublicMedia | null;
  class?: string;
}

const {
  slug,
  name,
  summary,
  shifts = [],
  index,
  image,
  class: className,
} = Astro.props;
const href = `/ensino#${slug}`;
const displayNumber =
  index !== undefined ? String(index + 1).padStart(2, '0') : null;
---

<a
  {href}
  class:list={['segment-card', 'editorial-surface', className]}
  data-reveal
  style={index !== undefined ? `--reveal-delay: ${index * 70}ms` : undefined}
>
  <div class="card-media media-frame">
    {
      image ? (
        <img
          src={image.src}
          srcset={responsiveSrcset(image.src, image.width)}
          sizes="(min-width: 1100px) 25vw, (min-width: 768px) 50vw, 100vw"
          alt={image.alt}
          width={image.width}
          height={image.height}
          style={focalPointStyle(image.focalPoint)}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <AssetPlaceholder aspectRatio="4/3" />
      )
    }
    {
      displayNumber && (
        <span class="editorial-number card-badge" aria-hidden="true">
          {displayNumber}
        </span>
      )
    }
  </div>

  <div class="card-body">
    <h3 class="card-title">{name}</h3>
    {summary && <p class="card-summary">{summary}</p>}
    {
      shifts.length > 0 && (
        <ul class="card-shifts" aria-label="Turnos disponíveis">
          {shifts.map((shift) => (
            <li>{shift.split(':')[0]}</li>
          ))}
        </ul>
      )
    }
    <span class="card-link">
      <span>Conhecer esta etapa</span>
      <span class="card-link-arrow" aria-hidden="true">↗</span>
    </span>
  </div>
</a>

<style>
  .segment-card {
    display: flex;
    flex-direction: column;
    background: var(--surface-soft);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  @media (hover: hover) {
    .segment-card:hover {
      background: #ffffff;
      border-color: rgba(0, 76, 115, 0.28);
      box-shadow: var(--shadow-elevated);
    }
  }

  .segment-card:focus-visible {
    outline: 3px solid var(--brand-navy);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px #ffffff;
  }

  .card-media {
    position: relative;
    border-radius: 0;
    aspect-ratio: 4 / 3;
  }

  .card-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
  }

  .card-body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .card-title {
    margin: 0;
    font-size: calc(clamp(1.2rem, 1.8vw, 1.45rem) * var(--display-scale));
    line-height: 1.18;
    color: var(--text-ink);
  }

  .card-summary {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--text-body);
  }

  .card-shifts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 2px 0 0;
    padding: 0;
  }

  .card-shifts li {
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--brand-navy);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
    color: var(--brand-navy);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .card-link-arrow {
    display: inline-block;
    transition: transform 280ms var(--ease);
  }

  @media (hover: hover) {
    .segment-card:hover .card-link {
      color: var(--action-primary);
    }
    .segment-card:hover .card-link-arrow {
      transform: translate(3px, -3px);
    }
  }
</style>
