---
import PageShell from '../layouts/PageShell.astro';
import Button from '../components/Button.astro';
import { h1 } from '../lib/copy';
---

<PageShell title="Página não encontrada">
  <section class="container not-found">
    <h1>{h1.notFound}</h1>
    <p>Não encontramos a página que você procura.</p>
    <nav class="not-found-actions" aria-label="Ações">
      <ul>
        <li>
          <Button href="/" variant="primary">Voltar ao início</Button>
        </li>
        <li>
          <Button href="/visite" variant="secondary">Falar com o colégio</Button
          >
        </li>
      </ul>
    </nav>
  </section>
</PageShell>
<style>
  .not-found {
    padding-block: var(--space-12);
  }
  .not-found h1 {
    margin: 0 0 var(--space-4);
  }
  .not-found p {
    margin: 0 0 var(--space-6);
  }
  .not-found-actions ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    .not-found {
      padding-block: var(--space-16);
    }
  }
  @media (min-width: 1100px) {
    .not-found {
      padding-block: var(--space-20);
    }
  }
</style>
