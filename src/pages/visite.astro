---
import PageShell from '../layouts/PageShell.astro';
import PageIntro from '../components/PageIntro.astro';
import ContactPanel from '../components/ContactPanel.astro';
import FAQ from '../components/FAQ.astro';
import { h1, pageTitles } from '../lib/copy';
import {
  getActivities,
  getSegments,
  getFaqs,
  getPageCopy,
} from '../lib/content';

const pageCopy = getPageCopy('visite');
const segments = getSegments();
const activities = getActivities();
const faqs = getFaqs('visita');
---

<PageShell title={pageTitles.visite} description={pageCopy?.metaDescription}>
  <PageIntro
    breadcrumb={[{ label: 'Início', href: '/' }, { label: 'Visite' }]}
    eyebrow="Atendimento às famílias"
    title={pageCopy?.title ?? h1.visite}
    intro={pageCopy?.intro ?? undefined}
    variant="paper"
  />

  <section class="band-light">
    <div class="container">
      <ContactPanel
        segments={segments.map((s) => ({ slug: s.slug, name: s.name }))}
        activities={activities.map((a) => ({ slug: a.slug, name: a.name }))}
      />
    </div>
  </section>

  {faqs.length > 0 && <FAQ items={faqs} />}
</PageShell>
