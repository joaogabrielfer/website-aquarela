---
import PageShell from '../layouts/PageShell.astro';
import PageIntro from '../components/PageIntro.astro';
import ApprovalGroupIsland from '../islands/ApprovalGroupIsland.svelte';
import EmptyState from '../components/EmptyState.astro';
import VisitCTA from '../components/VisitCTA.astro';
import { h1, pageTitles, empty } from '../lib/copy';
import { getApprovalsGrouped, getMediaById, getPageCopy } from '../lib/content';

const pageCopy = getPageCopy('aprovacoes');
const groups = getApprovalsGrouped();
const hasApprovals = groups.length > 0;
---

<PageShell
  title={pageTitles.aprovacoes}
  description={pageCopy?.metaDescription}
>
  <PageIntro
    breadcrumb={[{ label: 'Início', href: '/' }, { label: 'Aprovações' }]}
    eyebrow="Resultados reais"
    title={pageCopy?.title ?? h1.aprovacoes}
    intro={pageCopy?.intro ?? undefined}
    variant="achievements"
  />

  {
    hasApprovals ? (
      <section class="band-light">
        <div class="container">
          {groups.map((group) => (
            <div class="approval-group">
              <div class="approval-year-head">
                <p class="eyebrow">Turma e processos</p>
                <h2 class="approval-year">{group.year}</h2>
              </div>
              <ApprovalGroupIsland
                client:load
                approvals={group.items.map((a) => ({
                  id: a.id,
                  displayName: a.displayName,
                  achievements: a.achievements,
                  year: a.year,
                  portraitUrl: a.portraitId
                    ? (getMediaById(a.portraitId)?.src ?? null)
                    : null,
                  portraitAlt: a.portraitId
                    ? (getMediaById(a.portraitId)?.alt ?? a.displayName)
                    : a.displayName,
                }))}
              />
            </div>
          ))}
          <a
            href="/ensino#ensino-medio"
            class="editorial-link editorial-action"
          >
            <span>Conheça o Ensino Médio</span>
            <span class="editorial-link__arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </div>
      </section>
    ) : (
      <section class="band-light">
        <div class="container">
          <EmptyState
            title={empty.approvals[0]}
            text={empty.approvals[1]}
            link={{ href: '/visite', label: 'Fale com a equipe' }}
            variant="compact"
          />
          <a
            href="/ensino#ensino-medio"
            class="editorial-link editorial-action"
          >
            <span>Conheça o Ensino Médio</span>
            <span class="editorial-link__arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </div>
      </section>
    )
  }

  <VisitCTA closingPhotoId="ensino-estudantes-na-escada" />
</PageShell>

<style>
  .approval-group {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .approval-year-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .approval-year {
    margin: 0;
  }
</style>
