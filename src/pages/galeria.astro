---
import PageShell from '../layouts/PageShell.astro';
import PageIntro from '../components/PageIntro.astro';
import EmptyState from '../components/EmptyState.astro';
import VisitCTA from '../components/VisitCTA.astro';
import AlbumGridIsland from '../islands/AlbumGridIsland.svelte';
import { h1, pageTitles, empty } from '../lib/copy';
import { getAlbums, getMediaById, getPageCopy } from '../lib/content';
import { getPublicSchool } from '../lib/content/school';

const pageCopy = getPageCopy('galeria');
const albums = getAlbums();
const hasAlbums = albums.length > 0;
const school = getPublicSchool();
const hasInstagram = school.instagramUrl !== null;
---

<PageShell title={pageTitles.galeria} description={pageCopy?.metaDescription}>
  <PageIntro
    breadcrumb={[{ label: 'Início', href: '/' }, { label: 'Galeria' }]}
    title={pageCopy?.title ?? h1.galeria}
    intro={pageCopy?.intro ?? undefined}
    variant="default"
  />

  {
    hasAlbums ? (
      <section class="section-gallery">
        <div class="container">
          <AlbumGridIsland
            client:load
            albums={albums.map((a) => {
              const coverMedia = getMediaById(a.coverId);
              return {
                slug: a.slug,
                title: a.title,
                date: a.date,
                category: a.category,
                coverUrl: coverMedia?.src ?? null,
                coverAlt: coverMedia?.alt ?? a.title,
              };
            })}
          />
          {hasInstagram && (
            <a
              href={school.instagramUrl!}
              class="section-link"
              target="_blank"
              rel="noopener"
            >
              Acompanhe no Instagram
            </a>
          )}
        </div>
      </section>
    ) : (
      <section class="section-empty">
        <div class="container">
          <EmptyState
            title={empty.gallery[0]}
            text={empty.gallery[1]}
            link={
              hasInstagram
                ? {
                    href: school.instagramUrl!,
                    label: 'Acompanhe no Instagram',
                  }
                : undefined
            }
          />
        </div>
      </section>
    )
  }

  <VisitCTA />
</PageShell>

<style>
  .section-gallery,
  .section-empty {
    padding: var(--space-12) 0;
    background: var(--surface-base);
  }
  .section-link {
    display: inline-flex;
    align-items: center;
    margin-top: var(--space-6);
    color: var(--brand-navy);
    font-weight: 500;
    text-decoration: underline;
  }
  @media (min-width: 768px) {
    .section-gallery,
    .section-empty {
      padding: var(--space-16) 0;
    }
  }
  @media (min-width: 1100px) {
    .section-gallery,
    .section-empty {
      padding: var(--space-20) 0;
    }
  }
</style>
