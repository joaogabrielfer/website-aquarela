---
import PageShell from '../layouts/PageShell.astro';
import PageIntro from '../components/PageIntro.astro';
import EnvironmentCard from '../components/EnvironmentCard.astro';
import EmptyState from '../components/EmptyState.astro';
import VisitCTA from '../components/VisitCTA.astro';
import Lightbox from '../islands/Lightbox.svelte';
import { h1, pageTitles, empty } from '../lib/copy';
import { getEnvironments, getMediaById, getPageCopy } from '../lib/content';

const pageCopy = getPageCopy('nosso-espaco');
const environments = getEnvironments();
const hasEnvironments = environments.length > 0;

// Pre-process environment data for rendering
const envData = environments.map((env, i) => {
  const coverMedia = env.images[0] ? getMediaById(env.images[0]) : null;
  const allPhotos = env.images
    .map((imgId) => getMediaById(imgId))
    .filter(
      (p): p is NonNullable<ReturnType<typeof getMediaById>> => p !== null,
    );
  return {
    env,
    index: i,
    coverMedia,
    allPhotos,
  };
});
---

<PageShell
  title={pageTitles['nosso-espaco']}
  description={pageCopy?.metaDescription ?? 'Conheça o espaço do Aquarela.'}
>
  <PageIntro
    breadcrumb={[{ label: 'Início', href: '/' }, { label: 'Nosso espaço' }]}
    title={h1['nosso-espaco']}
    intro={pageCopy?.intro ?? undefined}
    variant="space"
  />

  {
    hasEnvironments ? (
      <section class="section-environments">
        <div class="container env-grid">
          {envData.map(({ env, index, coverMedia, allPhotos }) => (
            <EnvironmentCard
              name={env.name}
              purpose={env.purpose}
              imageUrl={coverMedia?.src ?? null}
              imageAlt={coverMedia?.alt ?? env.name}
              caption={coverMedia?.caption}
              feature={index === 0}
              photos={allPhotos.map((p) => ({
                src: p.src,
                alt: p.alt,
                caption: p.caption,
              }))}
            />
          ))}
        </div>
      </section>
    ) : (
      <section class="section-empty">
        <div class="container">
          <EmptyState
            title={empty.space[0]}
            text={empty.space[1]}
            link={{ href: '/visite', label: 'Fale com a equipe' }}
          />
        </div>
      </section>
    )
  }

  <VisitCTA />
  <Lightbox client:only="svelte" />
</PageShell>

<style>
  .section-environments {
    padding: var(--space-12) 0;
    background: var(--surface-base);
  }
  .section-empty {
    padding: var(--space-12) 0;
    background: var(--surface-base);
  }
  .env-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 768px) {
    .section-environments,
    .section-empty {
      padding: var(--space-16) 0;
    }
    .env-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .section-environments,
    .section-empty {
      padding: var(--space-20) 0;
    }
  }
</style>
