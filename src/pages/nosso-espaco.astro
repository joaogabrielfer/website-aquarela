---
import PageShell from '../layouts/PageShell.astro';
import PageIntro from '../components/PageIntro.astro';
import EnvironmentCard from '../components/EnvironmentCard.astro';
import EditorialInterlude from '../components/EditorialInterlude.astro';
import EmptyState from '../components/EmptyState.astro';
import VisitCTA from '../components/VisitCTA.astro';
import Lightbox from '../islands/Lightbox.svelte';
import { h1, pageTitles, empty } from '../lib/copy';
import { getEnvironments, getMediaById, getPageCopy } from '../lib/content';

const pageCopy = getPageCopy('nosso-espaco');
const environments = getEnvironments();
const hasEnvironments = environments.length > 0;
const heroMedia = getMediaById('piscina-angulo-principal');
const midInterlude = getMediaById('quadra-coberta-angulo-principal');

const firstAct = environments.slice(0, 5);
const secondAct = environments.slice(5);
---

<PageShell
  title={pageTitles['nosso-espaco']}
  description={pageCopy?.metaDescription}
>
  <PageIntro
    breadcrumb={[{ label: 'Início', href: '/' }, { label: 'Nosso espaço' }]}
    eyebrow="Arquitetura & rotina"
    title={pageCopy?.title ?? h1['nosso-espaco']}
    intro={pageCopy?.intro ?? undefined}
    media={heroMedia}
    variant="space"
  />

  {
    hasEnvironments ? (
      <>
        <section class="band-light">
          <div class="container">
            <div class="env-grid">
              {firstAct.map((env, index) => {
                const photos = env.images
                  .map(getMediaById)
                  .filter((media) => media !== null);
                const firstMedia = photos[0] ?? null;
                return (
                  <EnvironmentCard
                    name={env.name}
                    purpose={env.purpose}
                    {index}
                    imageUrl={firstMedia?.src ?? null}
                    imageAlt={firstMedia?.alt ?? env.name}
                    caption={firstMedia?.caption ?? null}
                    imageWidth={firstMedia?.width}
                    imageHeight={firstMedia?.height}
                    imageFocalPoint={firstMedia?.focalPoint}
                    feature={index === 0}
                    photos={photos.map((photo) => ({
                      src: photo.src,
                      alt: photo.alt,
                      caption: photo.caption,
                    }))}
                  />
                );
              })}
            </div>
          </div>
        </section>

        {midInterlude && secondAct.length > 0 && (
          <EditorialInterlude
            media={midInterlude}
            eyebrow="Convivência e movimento"
            phrase="O espaço também educa."
            desktopFocus="50% 48%"
            mobileFocus="50% 48%"
          />
        )}

        {secondAct.length > 0 && (
          <section class="band-light">
            <div class="container">
              <div class="env-grid">
                {secondAct.map((env, idx) => {
                  const index = idx + firstAct.length;
                  const photos = env.images
                    .map(getMediaById)
                    .filter((media) => media !== null);
                  const firstMedia = photos[0] ?? null;
                  return (
                    <EnvironmentCard
                      name={env.name}
                      purpose={env.purpose}
                      {index}
                      imageUrl={firstMedia?.src ?? null}
                      imageAlt={firstMedia?.alt ?? env.name}
                      caption={firstMedia?.caption ?? null}
                      imageWidth={firstMedia?.width}
                      imageHeight={firstMedia?.height}
                      imageFocalPoint={firstMedia?.focalPoint}
                      feature={idx === 0}
                      photos={photos.map((photo) => ({
                        src: photo.src,
                        alt: photo.alt,
                        caption: photo.caption,
                      }))}
                    />
                  );
                })}
              </div>
            </div>
          </section>
        )}
      </>
    ) : (
      <section class="band-light">
        <div class="container">
          <EmptyState
            title={empty.space[0]}
            text={empty.space[1]}
            link={{ href: '/visite', label: 'Agendar visita' }}
          />
        </div>
      </section>
    )
  }

  <VisitCTA closingPhotoId="patio" />
  <Lightbox client:only="svelte" />
</PageShell>

<style>
  .env-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .env-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }
</style>
