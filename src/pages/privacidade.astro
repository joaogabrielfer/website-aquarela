---
import PageShell from '../layouts/PageShell.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getPageCopy, getPrivacyDoc } from '../lib/content';
import { renderPrivacyMarkdown } from '../lib/privacy';
import { pageTitles } from '../lib/copy';

const privacy = getPrivacyDoc();
const pageCopy = getPageCopy('privacidade');
const renderedBody = renderPrivacyMarkdown(privacy.body);
---

<PageShell
  title={pageTitles.privacidade}
  description={pageCopy?.metaDescription}
>
  <section class="privacy-page">
    <div class="container">
      <article class="privacy-sheet">
        <Breadcrumb
          items={[{ label: 'Início', href: '/' }, { label: 'Privacidade' }]}
        />

        <h1>{pageCopy?.title ?? pageTitles.privacidade}</h1>

        {
          renderedBody ? (
            <div class="privacy-content reading" set:html={renderedBody} />
          ) : (
            <p class="privacy-pending">
              Documento de privacidade em elaboração.
            </p>
          )
        }
      </article>
    </div>
  </section>
</PageShell>

<style>
  .privacy-page {
    padding-block: var(--section-pad);
    background: var(--surface-soft);
  }

  .privacy-sheet {
    max-width: 880px;
    margin-inline: auto;
    padding: clamp(1.5rem, 4.5vw, 3.5rem);
    border-radius: 28px;
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  h1 {
    margin: 0;
  }

  .privacy-content {
    color: var(--text-body);
  }

  .privacy-content :global(h2) {
    font-size: calc(clamp(1.25rem, 2.2vw, 1.65rem) * var(--display-scale));
    margin-top: 28px;
    margin-bottom: 12px;
  }

  .privacy-content :global(p) {
    margin: 0 0 16px;
  }

  .privacy-content :global(ul) {
    margin: 0 0 16px;
    padding-left: 22px;
  }

  .privacy-content :global(li) {
    margin-bottom: 8px;
  }

  .privacy-pending {
    color: var(--text-muted);
    font-style: italic;
  }
</style>
