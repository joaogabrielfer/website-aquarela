---
import PageShell from '../layouts/PageShell.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getPageCopy, getPrivacyDoc } from '../lib/content';
import { renderPrivacyMarkdown } from '../lib/privacy';
import { pageTitles } from '../lib/copy';

const privacy = getPrivacyDoc();
const pageCopy = getPageCopy('privacidade');
const renderedBody = renderPrivacyMarkdown(privacy.body);
---

<PageShell
  title={pageTitles.privacidade}
  description={pageCopy?.metaDescription}
>
  <section class="privacy-page">
    <div class="container privacy-inner">
      <Breadcrumb
        items={[{ label: 'Início', href: '/' }, { label: 'Privacidade' }]}
      />

      <h1>{pageCopy?.title ?? pageTitles.privacidade}</h1>

      {
        renderedBody ? (
          <div class="privacy-content reading" set:html={renderedBody} />
        ) : (
          <p class="privacy-pending">Documento de privacidade em elaboração.</p>
        )
      }
    </div>
  </section>
</PageShell>

<style>
  .privacy-page {
    padding: var(--space-12) 0;
    background: var(--surface-base);
  }
  .privacy-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  h1 {
    margin: 0;
  }
  .privacy-content {
    color: var(--text-ink);
  }
  .privacy-content :global(h2) {
    font-size: 1.5rem;
    margin-top: var(--space-6);
  }
  .privacy-content :global(p) {
    margin: 0 0 var(--space-4);
  }
  .privacy-content :global(ul) {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-6);
  }
  .privacy-content :global(li) {
    margin-bottom: var(--space-2);
  }
  .privacy-pending {
    color: var(--text-muted);
    font-style: italic;
  }
  @media (min-width: 768px) {
    .privacy-page {
      padding: var(--space-16) 0;
    }
  }
  @media (min-width: 1100px) {
    .privacy-page {
      padding: var(--space-20) 0;
    }
  }
</style>
