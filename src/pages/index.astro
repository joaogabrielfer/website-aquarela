---
import PageShell from '../layouts/PageShell.astro';
import HeroHome from '../components/HeroHome.astro';
import InstitutionalTicker from '../components/InstitutionalTicker.astro';
import HomeEditorialBody from '../components/HomeEditorialBody.astro';
import { h1, pageTitles } from '../lib/copy';
import { getHomePageCopy, getMediaById } from '../lib/content';

const pageCopy = getHomePageCopy();
const support = pageCopy?.intro ?? '';
const heroMedia = pageCopy?.heroImageId
  ? getMediaById(pageCopy.heroImageId)
  : null;
---

<PageShell title={pageTitles.home} description={pageCopy?.metaDescription}>
  <div class="home-first-screen">
    <HeroHome
      title={pageCopy?.title ?? h1.home}
      support={support}
      imageSrc={heroMedia?.src ?? null}
      imageAlt={heroMedia?.alt}
      imageWidth={heroMedia?.width}
      imageHeight={heroMedia?.height}
      imageFocalPoint={heroMedia?.focalPoint}
    />
    <InstitutionalTicker />
  </div>

  <HomeEditorialBody />
</PageShell>

<style>
  .home-first-screen {
    min-height: calc(100svh - var(--site-header-height));
    display: flex;
    flex-direction: column;
  }

  .home-first-screen :global(.hero-home) {
    flex: 1;
  }
</style>
