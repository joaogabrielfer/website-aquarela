---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BUILD_MODE, IS_CF_PREVIEW, SITE_URL } from '../lib/env';

interface Props {
  title: string;
  description?: string | undefined;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const noindex = BUILD_MODE === 'editorial-preview' || IS_CF_PREVIEW;
const fullTitle =
  title === 'Aquarela Colégio e Curso | Paulista/PE'
    ? title
    : `${title} | Aquarela Colégio e Curso`;
const canonicalUrl = SITE_URL ? `${SITE_URL}${Astro.url.pathname}` : undefined;
const ogImageUrl =
  ogImage ?? (SITE_URL ? `${SITE_URL}/brand/logo-aquarela.png` : undefined);
---

<!doctype html>
<html lang="pt-BR">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width"
    /><title>{fullTitle}</title>{
      description && <meta name="description" content={description} />
    }{noindex && <meta name="robots" content="noindex" />}<link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32.png"
    /><link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/favicon-192.png"
    /><link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png"
    />{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}{
      SITE_URL && (
        <>
          <meta property="og:title" content={fullTitle} />
          {description && (
            <meta property="og:description" content={description} />
          )}
          <meta property="og:type" content="website" />
          <meta property="og:url" content={canonicalUrl} />
          <meta property="og:locale" content="pt_BR" />
          {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
        </>
      )
    }</head
  ><body
    >{
      BUILD_MODE === 'editorial-preview' && (
        <div class="preview-banner">Prévia editorial — conteúdo pendente</div>
      )
    }<a class="skip-link" href="#main-content">Pular para o conteúdo</a><Header
    /><main id="main-content" tabindex="-1"><slot /></main><Footer /></body
  >
</html>
<style>
  .preview-banner {
    position: relative;
    z-index: 60;
    background: var(--brand-yellow);
    color: var(--text-ink);
    padding: 8px 20px;
    text-align: center;
    font-weight: 500;
  }
</style>
