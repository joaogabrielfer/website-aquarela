---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/editorial.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ENABLE_SMOOTH_SCROLL, IS_CF_PREVIEW, SITE_URL } from '../lib/env';
import { getPublicSchool } from '../lib/content/school';
import SmoothScroll from '../islands/SmoothScroll.svelte';
import EditorialMotion from '../islands/EditorialMotion.svelte';
import HomeVariantSwitcher from '../islands/HomeVariantSwitcher.svelte';

interface Props {
  title: string;
  description?: string | undefined;
  ogImage?: string;
  headerOverlay?: boolean;
  forceNoindex?: boolean;
}

const {
  title,
  description,
  ogImage,
  headerOverlay = false,
  forceNoindex = false,
} = Astro.props;
const noindex = IS_CF_PREVIEW || forceNoindex;
const showVariantSwitcher = import.meta.env.DEV || IS_CF_PREVIEW;
const school = getPublicSchool();
const fullTitle =
  title === 'Aquarela Colégio e Curso | Paulista/PE'
    ? title
    : `${title} | Aquarela Colégio e Curso`;
const canonicalUrl = SITE_URL ? `${SITE_URL}${Astro.url.pathname}` : undefined;
const ogImageUrl =
  ogImage ?? (SITE_URL ? `${SITE_URL}/brand/logo-aquarela.png` : undefined);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'School',
      name: school.name,
      ...(school.tagline ? { slogan: school.tagline } : {}),
      ...(SITE_URL ? { url: SITE_URL } : {}),
      ...(school.phoneE164 ? { telephone: school.phoneE164 } : {}),
      ...(school.instagramUrl ? { sameAs: [school.instagramUrl] } : {}),
      ...(school.address
        ? {
            address: {
              '@type': 'PostalAddress',
              streetAddress: [school.address.street, school.address.number]
                .filter(Boolean)
                .join(', '),
              addressLocality: school.address.city,
              addressRegion: school.address.state,
              addressCountry: 'BR',
            },
          }
        : {}),
    },
    {
      '@type': 'WebPage',
      name: fullTitle,
      ...(description ? { description } : {}),
      inLanguage: 'pt-BR',
      ...(canonicalUrl ? { url: canonicalUrl } : {}),
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    /><meta name="theme-color" content="#0c1b26" /><title>{fullTitle}</title>{
      description && <meta name="description" content={description} />
    }{noindex && <meta name="robots" content="noindex" />}<link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32.png"
    /><link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/favicon-192.png"
    /><link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png"
    />{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}{
      SITE_URL && (
        <>
          <meta property="og:title" content={fullTitle} />
          {description && (
            <meta property="og:description" content={description} />
          )}
          <meta property="og:type" content="website" />
          <meta property="og:url" content={canonicalUrl} />
          <meta property="og:locale" content="pt_BR" />
          {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
        </>
      )
    }<script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    /><script is:inline>
      (() => {
        try {
          if (window.sessionStorage.getItem('aquarela-motion') === 'reduced') {
            document.documentElement.dataset.motion = 'reduced';
          }
        } catch {}
      })();
    </script></head
  ><body
    ><a class="skip-link" href="#main-content">Pular para o conteúdo</a><Header
      overlay={headerOverlay}
    /><main id="main-content" tabindex="-1"><slot /></main><Footer />{
      ENABLE_SMOOTH_SCROLL && <SmoothScroll client:load />
    }<EditorialMotion client:load />{
      showVariantSwitcher && (
        <HomeVariantSwitcher client:load currentPath={Astro.url.pathname} />
      )
    }</body
  >
</html>
